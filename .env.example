# =============================================================
# Origin & Everlasting Trading PLC — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# =============================================================

# ----- App -----
# The full public URL of your deployment (no trailing slash)
# Example: https://originandeverlasting.com
APP_URL=https://yourdomain.com
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ----- Node -----
NODE_ENV=production
PORT=3000

# ----- Gemini AI -----
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ----- Supabase -----
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ----- Resend (Email) -----
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
# Optional: override the default sender address
RESEND_FROM_EMAIL=noreply@originandeverlasting.com

# ----- Chapa (ETB Payments) -----
# Get your key at: https://dashboard.chapa.co/
CHAPA_SECRET_KEY=your_chapa_secret_key

# ----- Stripe (USD Payments) -----
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key
